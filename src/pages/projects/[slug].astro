---
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import ProgrammaticVisual from '~/components/astro/ProgrammaticVisual.astro';
import {
  getProjects,
  projectUrl,
  formatDate,
  formatDateShort,
} from '~/lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.data.slug ?? project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const others = (await getProjects()).filter((p) => p.id !== project.id).slice(0, 2);

const coverVisual: Record<string, 'nodes' | 'wireframe' | 'browser' | 'terminal'> = {
  '3d': 'wireframe',
  ai: 'nodes',
  web: 'browser',
  tool: 'terminal',
};

const { github, demo } = project.data;
---

<BaseLayout
  title={`${project.data.title} — 项目`}
  description={project.data.description}
>
  <!-- 项目 Hero -->
  <header class="relative overflow-hidden border-b border-[var(--border)]">
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="grid-bg"></div>
      <div
        class="absolute inset-0"
        style="background: radial-gradient(640px circle at 24% 20%, var(--primary-soft), transparent 70%);"
      >
      </div>
    </div>

    <div class="container-page pb-14 pt-[calc(var(--nav-height)+56px)]">
      <a
        href="/projects"
        class="mono inline-flex items-center gap-2 text-[12px] text-[var(--muted)] transition-colors hover:text-[var(--foreground)]"
      >
        ← 项目列表
      </a>

      <div class="mt-8 grid items-end gap-10 lg:grid-cols-[1.5fr_1fr]">
        <div>
          <div class="mono flex flex-wrap items-center gap-3 text-[11px] text-[var(--faint)]">
            <span class="rounded-[var(--radius-xs)] border border-[var(--border)] px-2 py-1 text-[var(--muted)]">
              {project.data.category}
            </span>
            <span class="flex items-center gap-1.5">
              <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--cyan)] pulse-dot"></span>
              {project.data.status}
            </span>
            <span>{formatDate(project.data.date)}</span>
          </div>

          <h1 class="mt-5 text-balance text-[34px] font-semibold leading-[1.15] tracking-[-0.025em] text-[var(--foreground-strong)] sm:text-[46px]">
            {project.data.title}
          </h1>

          <p class="mt-5 max-w-[56ch] text-[15.5px] leading-[1.85] text-[var(--muted)]">
            {project.data.description}
          </p>

          <div class="mt-8 flex flex-wrap items-center gap-3">
            {github && (
              <a href={github} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.203 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"></path>
                </svg>
                源代码
              </a>
            )}
            {demo && (
              <a href={demo} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
                在线预览
                <svg class="btn-arrow h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6"></path>
                </svg>
              </a>
            )}
          </div>
        </div>

        <!-- 关键指标 -->
        {
          project.data.highlights.length > 0 && (
            <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--border-faint)]">
              {project.data.highlights.map((item) => (
                <div class="flex flex-col gap-1 bg-[var(--surface)] p-5">
                  <dt class="mono text-[10.5px] tracking-[0.1em] text-[var(--faint)] uppercase">
                    {item.label}
                  </dt>
                  <dd class="mono text-[19px] font-medium text-[var(--foreground-strong)]">
                    {item.value}
                  </dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </div>
  </header>

  <!-- 主体：正文 + 侧栏 -->
  <div class="container-narrow grid gap-12 py-16 lg:grid-cols-[minmax(0,1fr)_240px]">
    <div class="prose mx-auto max-w-[var(--article-width)] lg:mx-0">
      <Content />
    </div>

    <aside class="order-first lg:order-none">
      <div class="sticky top-[calc(var(--nav-height)+40px)] space-y-8">
        {
          project.data.cover ? (
            <img
              src={project.data.cover}
              alt={`${project.data.title} 封面`}
              width="480"
              height="300"
              loading="lazy"
              class="w-full rounded-[var(--radius)] border border-[var(--border)]"
            />
          ) : (
            <div class="relative aspect-[8/5] overflow-hidden rounded-[var(--radius)] border border-[var(--border)]" aria-hidden="true">
              <ProgrammaticVisual variant={coverVisual[project.data.category] ?? 'browser'} />
            </div>
          )
        }

        <div>
          <p class="eyebrow">技术栈</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {project.data.stack.map((tech) => (
              <span class="chip">{tech}</span>
            ))}
          </div>
        </div>

        <div class="mono space-y-2 border-t border-[var(--border-faint)] pt-5 text-[11.5px] text-[var(--faint)]">
          <p>创建 · {formatDate(project.data.date)}</p>
          {project.data.updatedAt && <p>更新 · {formatDate(project.data.updatedAt)}</p>}
          <p>状态 · {project.data.status}</p>
        </div>
      </div>
    </aside>
  </div>

  {
    others.length > 0 && (
      <section class="container-page pb-20" aria-label="相关项目">
        <div class="mb-6 flex items-center gap-4">
          <span class="mono text-[12px] font-medium text-[var(--foreground-strong)]">其他项目</span>
          <span class="h-px flex-1 bg-[var(--border-faint)]" />
          <a href="/projects" class="mono text-[11.5px] text-[var(--faint)] transition-colors hover:text-[var(--foreground)]">
            全部 →
          </a>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {others.map((item) => (
            <a
              href={projectUrl(item)}
              class="group spotlight relative rounded-[var(--radius)] border border-[var(--border)] bg-[var(--surface)] p-5 transition-colors duration-300 hover:border-[var(--border-strong)]"
              data-spotlight
            >
              <p class="mono text-[10.5px] text-[var(--faint)]">
                {item.data.category} · {formatDateShort(item.data.date)}
              </p>
              <h3 class="mt-2 text-[15.5px] font-semibold text-[var(--foreground-strong)] transition-transform duration-300 group-hover:translate-x-0.5">
                {item.data.title}
              </h3>
              <p class="mt-1.5 line-clamp-2 text-[13px] leading-relaxed text-[var(--muted)]">
                {item.data.description}
              </p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
