---
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getNotes, formatDate } from '~/lib/content';

const notes = await getNotes();

const rendered = await Promise.all(
  notes.map(async (note) => {
    const { Content } = await render(note);
    return { note, Content };
  })
);

// 按年分组
const byYear = new Map<number, typeof rendered>();
for (const item of rendered) {
  const year = item.note.data.publishedAt.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(item);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout
  title={`笔记 — darmk 个人空间`}
  description="一些不值得写成长文章，但值得记录下来的东西。"
>
  <div class="container-narrow pb-10 pt-[calc(var(--nav-height)+56px)]">
    <header class="max-w-[52ch]">
      <div class="mb-3 flex items-center gap-3">
        <span class="mono text-[11px] tracking-[0.2em] text-[var(--primary)]">NOTES</span>
        <span class="h-px w-8 bg-[var(--border-strong)]"></span>
        <span class="mono text-[11px] tracking-[0.16em] text-[var(--faint)] uppercase">
          {notes.length} notes
        </span>
      </div>
      <h1 class="text-balance text-[36px] font-semibold leading-[1.12] tracking-[-0.025em] text-[var(--foreground-strong)] sm:text-[46px]">
        笔记
      </h1>
      <p class="mt-4 text-[15px] leading-relaxed text-[var(--muted)]">
        一些不值得写成长文章，但值得记录下来的东西。
      </p>
    </header>

    <div class="mt-16 space-y-14">
      {
        years.map((year) => (
          <section aria-label={`${year} 年笔记`}>
            <div class="mb-6 flex items-center gap-4">
              <span class="mono text-[13px] font-medium text-[var(--foreground-strong)]">{year}</span>
              <span class="h-px flex-1 bg-[var(--border-faint)]" />
            </div>

            <ol class="relative border-l border-[var(--border-faint)]">
              {byYear.get(year)!.map(({ note, Content }) => (
                <li class="group relative pl-8 sm:pl-10">
                  <span
                    class="absolute -left-[5px] top-[9px] h-[9px] w-[9px] rounded-full border-2 border-[var(--background)] bg-[var(--border-strong)] transition-colors duration-300 group-hover:bg-[var(--primary)]"
                    aria-hidden="true"
                  />
                  <div class="border-b border-[var(--border-faint)] py-6">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <h2 class="text-[15.5px] font-medium leading-snug text-[var(--foreground)] transition-colors duration-200 group-hover:text-[var(--foreground-strong)]">
                        {note.data.title}
                      </h2>
                      <span class="mono shrink-0 text-[11px] text-[var(--faint)]">
                        {formatDate(note.data.publishedAt)}
                        {note.data.source && ` · ${note.data.source}`}
                      </span>
                    </div>

                    <div class="prose prose-note mt-3 max-w-none text-[14px]">
                      <Content />
                    </div>

                    {note.data.tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-3">
                        {note.data.tags.map((tag) => (
                          <a
                            href={`/tags/${tag}`}
                            class="mono text-[10.5px] text-[var(--faint)] transition-colors hover:text-[var(--primary)]"
                          >
                            #{tag}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* 笔记正文更紧凑：压缩标题与代码块 */
  .prose-note {
    font-size: 14px;
    line-height: 1.8;
    color: var(--muted);
  }
  .prose-note :is(h2, h3) {
    font-size: 14.5px;
    margin-top: 1.6rem;
    color: var(--foreground);
  }
  .prose-note pre {
    font-size: 12.5px;
  }
  .prose-note .code-block {
    font-size: 12.5px;
  }
</style>
