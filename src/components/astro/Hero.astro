---
import { getPosts, getProjects, getNotes, formatDateShort } from '~/lib/content';
import { siteConfig } from '~/config/site';

const [posts, projects, notes] = await Promise.all([
  getPosts(),
  getProjects(),
  getNotes(),
]);

const latest = posts[0];
const updated = latest
  ? formatDateShort(latest.data.updatedAt ?? latest.data.publishedAt)
  : '——';

const tags = ['Web', 'AI', 'Three.js', 'Engineering'];
---

<section
  id="hero"
  class="relative isolate flex min-h-[90vh] items-center overflow-hidden pb-16 pt-[calc(var(--nav-height)+40px)]"
  data-spotlight-scope
  data-hero-root
>
  <!-- CSS-only engineering grid + mouse spotlight ------------------------ -->
  <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true">
    <div class="grid-bg"></div>
    <div
      class="hero-spotlight absolute inset-0"
      style="background: radial-gradient(560px circle at var(--mouse-x, 50%) var(--mouse-y, 40%), var(--primary-soft), transparent 68%);"
    >
    </div>
    <div
      class="absolute inset-x-0 top-0 h-[300px]"
      style="background: linear-gradient(to bottom, color-mix(in srgb, var(--primary) 6%, transparent), transparent);"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-40"
      style="background: linear-gradient(to top, var(--background), transparent);"
    >
    </div>
    <div class="hero-vignette absolute inset-0"></div>
  </div>

  <div class="container-page relative w-full">
    <div class="mx-auto grid max-w-[78rem] items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(24rem,25rem)] lg:gap-14">
      <!-- left: title ---------------------------------------------------- -->
      <div class="relative max-w-[46rem]">
        <p
          class="mono mb-6 flex items-center gap-2.5 text-[12px] tracking-[0.16em] text-[var(--faint)] uppercase"
          data-hero="eyebrow"
        >
          <span
            class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--primary)] pulse-dot"
          ></span>
          你好，我是 {siteConfig.author}
        </p>

        <h1
          class="text-balance text-[42px] font-semibold leading-[1.06] tracking-[-0.03em] text-[var(--foreground-strong)] sm:text-[58px] lg:text-[72px] xl:text-[80px]"
          data-hero="title"
        >
          <span class="block overflow-hidden"
            ><span class="block" data-hero-line>记录技术</span></span
          >
          <span class="block overflow-hidden"
            ><span class="block" data-hero-line>分享实践</span></span
          >
          <span class="block overflow-hidden"
            ><span class="block text-gradient" data-hero-line
              >探索有趣的东西</span
            ></span
          >
        </h1>

        <p
          class="mt-7 max-w-[42ch] text-[15.5px] leading-[1.85] text-[var(--muted)] sm:text-[16.5px]"
          data-hero="desc"
        >
          这里是 {siteConfig.author} 的个人空间。记录 Web、AI、工程实践、Three.js
          与 3D 可视化，以及开发过程中值得留下来的思考。
        </p>

        <!-- tags --------------------------------------------------------- -->
        <div class="mt-8 flex flex-wrap items-center gap-2" data-hero="tags">
          {
            tags.map((tag) => (
              <span
                class="mono rounded-[var(--radius-xs)] border border-[var(--border)] px-2.5 py-1 text-[11.5px] text-[var(--muted)]"
                data-hero-tag
              >
                {tag}
              </span>
            ))
          }
          <span class="mono ml-1 text-[11px] text-[var(--faint)]"
            >&lt;/&gt;</span
          >
        </div>

        <!-- CTA ---------------------------------------------------------- -->
        <div class="mt-10 flex flex-wrap items-center gap-3" data-hero="cta">
          <a href="/blog" class="btn btn-primary" data-magnetic>
            浏览文章
            <svg
              class="btn-arrow h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a href="/projects" class="btn btn-ghost" data-magnetic>
            查看项目
            <svg
              class="btn-arrow h-3.5 w-3.5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- right: stats card ---------------------------------------------- -->
      <aside
        class="hero-stats hidden w-full rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--surface)]/80 p-7 shadow-[0_18px_60px_-16px_rgba(0,0,0,0.35)] backdrop-blur-md lg:block"
        aria-label="站点状态"
      >
        <div class="flex items-center justify-between text-[12.5px]">
          <span class="text-[var(--faint)]">当前状态</span>
          <span class="mono flex items-center gap-1.5 font-medium text-[var(--cyan)]">
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-[var(--cyan)]"></span>
            ONLINE
          </span>
        </div>

        <div class="mt-7 space-y-5">
          <div class="flex items-center justify-between border-b border-[var(--border)] pb-4">
            <span class="text-[16px] text-[var(--foreground)]">文章</span>
            <span class="mono text-[34px] font-semibold leading-none text-[var(--foreground-strong)]">
              {String(posts.length).padStart(2, '0')}
            </span>
          </div>
          <div class="flex items-center justify-between border-b border-[var(--border)] pb-4">
            <span class="text-[16px] text-[var(--foreground)]">项目</span>
            <span class="mono text-[34px] font-semibold leading-none text-[var(--foreground-strong)]">
              {String(projects.length).padStart(2, '0')}
            </span>
          </div>
          <div class="flex items-center justify-between border-b border-[var(--border)] pb-4">
            <span class="text-[16px] text-[var(--foreground)]">笔记</span>
            <span class="mono text-[34px] font-semibold leading-none text-[var(--foreground-strong)]">
              {String(notes.length).padStart(2, '0')}
            </span>
          </div>
        </div>

        <div class="mt-6 flex items-center justify-between text-[12.5px]">
          <span class="text-[var(--faint)]">最近更新</span>
          <span class="mono text-[var(--muted)]">{updated}</span>
        </div>

        <div class="mt-5 flex items-center gap-2 rounded-[var(--radius-sm)] border border-[var(--border)] bg-[var(--background)]/60 px-3.5 py-3">
          <span class="mono mr-1 text-[var(--primary)]">$</span>
          <span class="mono text-[13.5px] text-[var(--foreground-strong)]">whoami</span>
          <span class="hero-cursor ml-0.5 inline-block h-4 w-[2px] bg-[var(--foreground-strong)]"></span>
        </div>

        <div class="mono mt-6 flex justify-center gap-2 text-[10.5px] tracking-[0.14em] text-[var(--faint)]">
          <span>CODE</span>
          <span>·</span>
          <span>BUILD</span>
          <span>·</span>
          <span>SHARE</span>
        </div>
      </aside>
    </div>
  </div>
</section>

<script>
  import '~/lib/hero-animation';
  import { initHeroParticles } from '~/lib/hero-particles';

  type WindowWithHero = Window & {
    __heroParticlesKill?: () => void;
  };
  const w = window as WindowWithHero;

  const bootstrap = () => {
    // kill previous run if View Transitions brought us back to a page that
    // already has particles (e.g. navigating back from another route).
    if (typeof w.__heroParticlesKill === 'function') {
      w.__heroParticlesKill();
      w.__heroParticlesKill = undefined;
    }
    // bail if Hero isn't on this page (PostClient-only routes etc.)
    if (!document.getElementById('hero')) return;
    w.__heroParticlesKill = initHeroParticles();
  };

  document.addEventListener('astro:page-swap', () => {
    if (typeof w.__heroParticlesKill === 'function') {
      w.__heroParticlesKill();
      w.__heroParticlesKill = undefined;
    }
  });
  document.addEventListener('astro:after-swap', bootstrap);
  bootstrap();
</script>

<style>
  /* Vignette darkens the corners slightly so the particle field reads as
     a "screen" the headline floats over. */
  .hero-vignette {
    background:
      radial-gradient(
        ellipse at center,
        transparent 55%,
        color-mix(in srgb, var(--background) 70%, transparent) 100%
      );
    pointer-events: none;
  }

  /* Canvas injected by hero-particles.ts sits at z 0 of the section
     (default for prepended child), content above. The H1 sits over the
     canvas so headline stays legible regardless of particle phase. */
  :global(#hero > canvas[data-hero-particles]) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero-cursor {
    animation: hero-cursor-blink 1.1s step-end infinite;
  }

  @keyframes hero-cursor-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
