---
import { wechatConfig } from '~/config/wechat';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  /** compact 用于文章正文之后，不渲染大区块 */
  variant?: 'section' | 'compact';
}

const { variant = 'section' } = Astro.props;

// 构建时探测二维码是否存在：不存在则显示占位状态，绝不生成假二维码
const qrExists = existsSync(
  join(process.cwd(), 'public', wechatConfig.qrCode.replace(/^\//, ''))
);
---

{variant === 'compact' ? (
  <aside
    class="not-prose mt-14 flex flex-col items-start gap-6 rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--surface)] p-6 sm:flex-row sm:items-center sm:gap-8"
    aria-label="微信公众号"
  >
    <div class="shrink-0">
      {qrExists ? (
        <img
          src={wechatConfig.qrCode}
          alt={`${wechatConfig.name} 公众号二维码`}
          width="112"
          height="112"
          loading="lazy"
          class="h-28 w-28 rounded-[var(--radius)] border border-[var(--border)]"
        />
      ) : (
        <div
          class="flex h-28 w-28 flex-col items-center justify-center gap-1.5 rounded-[var(--radius)] border border-dashed border-[var(--border-strong)] bg-[var(--background)]"
          aria-label="二维码占位"
        >
          <svg class="h-6 w-6 text-[var(--faint)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"></rect>
            <rect x="14" y="3" width="7" height="7" rx="1"></rect>
            <rect x="3" y="14" width="7" height="7" rx="1"></rect>
            <path d="M14 14h3v3h-3zM21 14v.01M14 21v.01M17.5 17.5h3.5v3.5"></path>
          </svg>
          <span class="mono text-[9.5px] text-[var(--faint)]">QR 待配置</span>
        </div>
      )}
    </div>

    <div class="min-w-0 flex-1">
      <p class="eyebrow">公众号</p>
      <p class="mt-2 text-[15px] font-medium text-[var(--foreground-strong)]">
        在微信继续阅读 · {wechatConfig.name}
      </p>
      <p class="mt-1.5 text-[13px] leading-relaxed text-[var(--muted)]">
        {wechatConfig.description}
      </p>
      <p class="mono mt-3 text-[11px] text-[var(--faint)]">{wechatConfig.tip}</p>
    </div>
  </aside>
) : (
  <section
    id="wechat"
    class="relative overflow-hidden border-y border-[var(--border)] bg-[var(--background-soft)]"
    aria-label="微信公众号"
  >
    <div class="absolute inset-0 -z-10" aria-hidden="true">
      <div class="grid-bg"></div>
      <div
        class="absolute inset-0"
        style="background: radial-gradient(600px circle at 78% 50%, var(--primary-soft), transparent 70%);"
      >
      </div>
    </div>

    <div class="container-page grid items-center gap-12 py-20 lg:grid-cols-[1fr_auto] lg:py-24">
      <div>
        <div class="mb-3 flex items-center gap-3">
          <span class="mono text-[11px] tracking-[0.2em] text-[var(--primary)]">05</span>
          <span class="h-px w-8 bg-[var(--border-strong)]"></span>
          <span class="mono text-[11px] tracking-[0.16em] text-[var(--faint)] uppercase">
            WeChat
          </span>
        </div>

        <h2 class="text-balance text-[26px] font-semibold leading-tight tracking-[-0.02em] text-[var(--foreground-strong)] sm:text-[32px]">
          公众号 · 在微信继续阅读
        </h2>

        <p class="mt-4 max-w-[46ch] text-[15px] leading-[1.85] text-[var(--muted)]">
          {wechatConfig.description}
          同步更新长文与专栏内容，也有些只在微信说的碎碎念。
        </p>

        <p class="mono mt-8 flex items-center gap-2 text-[11px] text-[var(--faint)]">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-[var(--cyan)] pulse-dot"></span>
          {wechatConfig.tip}
        </p>
      </div>

      <div class="justify-self-center lg:justify-self-end">
        <div
          class="spotlight group relative overflow-hidden rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--surface)] p-5"
          data-spotlight
        >
          <div
            class="absolute inset-x-0 top-0 h-px"
            style="background: linear-gradient(to right, transparent, var(--primary-glow), transparent);"
          >
          </div>

          {qrExists ? (
            <img
              src={wechatConfig.qrCode}
              alt={`${wechatConfig.name} 公众号二维码`}
              width="180"
              height="180"
              loading="lazy"
              class="h-44 w-44 rounded-[var(--radius)]"
            />
          ) : (
            <div
              class="flex h-44 w-44 flex-col items-center justify-center gap-2 rounded-[var(--radius)] border border-dashed border-[var(--border-strong)] bg-[var(--background)]"
              aria-label="二维码占位"
            >
              <svg class="h-8 w-8 text-[var(--faint)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
                <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                <path d="M14 14h3v3h-3zM21 14v.01M14 21v.01M17.5 17.5h3.5v3.5"></path>
              </svg>
              <span class="mono text-[10px] text-[var(--faint)]">二维码待配置</span>
              <span class="mono text-[9.5px] text-[var(--faint)] opacity-70">
                public{wechatConfig.qrCode}
              </span>
            </div>
          )}

          <p class="mono mt-4 text-center text-[11px] text-[var(--muted)]">
            {wechatConfig.tip} · {wechatConfig.name}
          </p>
        </div>
      </div>
    </div>
  </section>
)}
