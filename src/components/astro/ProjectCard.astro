---
import type { Project } from '~/lib/content';
import { formatDateShort, projectUrl } from '~/lib/content';
import ProgrammaticVisual from './ProgrammaticVisual.astro';

interface Props {
  project: Project;
  /** home 布局：横向卡片；projects 页：整宽行卡 */
  layout?: 'card' | 'row';
}

const { project, layout = 'card' } = Astro.props;

const coverVisual: Record<string, 'nodes' | 'wireframe' | 'browser' | 'terminal' | 'architecture' | 'pipeline'> = {
  '3d': 'wireframe',
  ai: 'nodes',
  web: 'browser',
  tool: 'terminal',
};

const statusDot =
  project.data.status === '持续优化'
    ? 'var(--cyan)'
    : project.data.status === '开发中'
      ? 'var(--amber)'
      : project.data.status === '暂停'
        ? 'var(--faint)'
        : 'var(--primary)';
---

<a
  href={projectUrl(project)}
  class:list={[
    'group spotlight relative flex overflow-hidden rounded-[var(--radius-lg)] border border-[var(--border)] bg-[var(--surface)] transition-[border-color] duration-300 ease-[var(--ease-out)] hover:border-[var(--border-strong)]',
    layout === 'card'
      ? 'flex-col'
      : 'flex-col sm:flex-row',
  ]}
  data-spotlight
  data-reveal
>
  {
    project.data.cover ? (
      <div class:list={[layout === 'card' ? 'aspect-[16/10]' : 'aspect-[16/9] sm:w-[300px] sm:shrink-0', 'relative overflow-hidden']}>
        <img
          src={project.data.cover}
          alt={`${project.data.title} 封面`}
          loading="lazy"
          decoding="async"
          class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-[var(--ease-out)] group-hover:scale-[1.02]"
        />
      </div>
    ) : (
      <div
        class:list={[
          'relative shrink-0 overflow-hidden border-b border-[var(--border-faint)] sm:border-b-0 sm:border-r',
          layout === 'card' ? 'aspect-[16/9]' : 'aspect-[16/9] sm:h-auto sm:w-[300px]',
        ]}
        aria-hidden="true"
      >
        <div class="absolute inset-0 opacity-70 transition-opacity duration-500 group-hover:opacity-100">
          <ProgrammaticVisual variant={coverVisual[project.data.category] ?? 'browser'} animated />
        </div>
        <div
          class="absolute inset-0"
          style="background: linear-gradient(to top, color-mix(in srgb, var(--surface) 85%, transparent), transparent 60%);"
        />
        <p class="mono absolute bottom-3 left-4 text-[10px] tracking-[0.14em] text-[var(--faint)] uppercase">
          {project.data.category}
        </p>
      </div>
    )
  }

  <div class="flex min-w-0 flex-1 flex-col p-5 sm:p-6">
    <div class="flex items-center gap-2.5">
      <h3 class="truncate text-[16.5px] font-semibold text-[var(--foreground-strong)] transition-transform duration-300 ease-[var(--ease-out)] group-hover:translate-x-0.5">
        {project.data.title}
      </h3>
    </div>

    <p class="mono mt-1.5 truncate text-[11px] text-[var(--faint)]">
      {project.data.stack.slice(0, 4).join(' · ')}
    </p>

    <p class="mt-3 line-clamp-2 text-[13.5px] leading-relaxed text-[var(--muted)]">
      {project.data.description}
    </p>

    <div class="mt-auto flex items-center justify-between pt-5">
      <span class="mono flex items-center gap-1.5 text-[11px] text-[var(--muted)]">
        <span
          class="inline-block h-1.5 w-1.5 rounded-full"
          style={`background: ${statusDot};`}
        ></span>
        {project.data.status}
      </span>

      <span class="flex items-center gap-3">
        <span class="mono hidden text-[11px] text-[var(--faint)] sm:inline">
          {formatDateShort(project.data.date)}
        </span>
        <span
          class="inline-flex items-center gap-1 text-[12.5px] text-[var(--muted)] transition-colors duration-200 group-hover:text-[var(--primary)]"
        >
          查看项目
          <svg
            class="h-3.5 w-3.5 transition-transform duration-300 ease-[var(--ease-out)] group-hover:translate-x-1"
            viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </span>
      </span>
    </div>
  </div>
</a>
